# Local development settings. Copy to .env (git ignores .env) and change the values.
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=support@nandivex.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password

# Email. Leave these out to catch mail in Mailpit (http://localhost:8025).
# To send real email through Resend (the nandivex.in domain must be verified in Resend first):
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASS=your-resend-api-key
# MAIL_FROM=NandiVex Technologies <noreply@nandivex.in>
